#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        // Layer thumbs: switch to the layer as soon as another key is pressed.
        lt_fast: layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Letter-key mod on A. require-prior-idle-ms is the important one:
        // if any key was pressed within 150 ms the hold is disabled outright, so
        // mid-word rolls resolve as plain letters and never leak a modifier.
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Modifier thumbs: conservative, so a fast tap never leaks a modifier.
        mt_slow: mod_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    // tmux prefix is C-Space (see ~/.tmux.conf). These fire prefix-then-key.
    macros {
        tmux_below: tmux_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp DQT>;
        };

        tmux_right: tmux_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp PRCNT>;
        };

        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp Z>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Home-row J+K (positions 16 and 17) -> Escape. Base layer only.
        combo_esc {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <16 17>;
            layers = <BASE>;
            bindings = <&kp ESC>;
        };
    };

    // Hold both layer thumbs (Space/Nav + Enter/Symbols) for the Adjust layer.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_sym_to_adj {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // 5-column US QWERTY: the 10 columns under Q-P, including ; , . /
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |
            // | A/A | S   | D   | F   | G   |     |  H  |  J  |  K  |  L  |  ;  |   A/A = Alt on hold
            // |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  |
            //             | SFT | ESC | ENT |     |     | SPC |BSPC |
            //             |     | CTL | SYM |     | NAV |     |     |
            display-name = "Base";
            bindings = <
                &kp Q            &kp W            &kp E             &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P
                &hm LALT A       &kp S            &kp D             &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z            &kp X            &kp C             &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
                               &kp LSHFT         &mt_slow LCTRL ESC  &lt_fast SYM RET         &mo NAV    &kp SPACE  &kp BSPC

            >;
        };

        nav_layer {
            // Hold the right inner Navigation thumb.
            // Left hand is the tmux / pane cluster, right hand is movement.
            // -----------------------------------------------------------------------------------------
            // | 1  | 2  | 3  | 4  | 5  |     | 6   | 7   | 8   | 9  | 0   |
            // |^H  |^J  |^K  |^L  |PFX |     | <-  | v   | ^   | -> | F11 |
            // |W<- |W-> |SPL-|SPL||ZOOM|     |HOME |PGDN |PGUP |END | F12 |
            //             |TAB |CTL |ADJ |     |    |    |DEL |
            display-name = "Nav";
            bindings = <
                &kp N1         &kp N2         &kp N3      &kp N4      &kp N5           &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &kp LC(H)      &kp LC(J)      &kp LC(K)   &kp LC(L)   &kp LC(SPACE)    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp F11
                &kp LA(LS(H))  &kp LA(LS(L))  &tmux_below &tmux_right &tmux_zoom       &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp F12
                                              &kp TAB     &trans      &trans           &trans     &trans     &kp DEL
            >;
        };

        sym_layer {
            // Hold the lefr inner Symbols thumb (Enter).
            // Top row mirrjrs the shifted number row. Every bracket pair is one-handed:
            // parens and brackets on the left, braces on the right.
            // ------------r----------------------------------------------------------------------------
            // | ! | @ | # | $ | % |     | ^ | & | * | ? | \ |
            // | ( | ) | [ | ] | = |     | { | } | | | " | ' |
            // | - | _ | ` | ~ | + |     | : | ; | < | > |   |
            //             |SFT |CTL |   |     |ADJ |    |    |
            display-name = "Sym";
            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT     &kp CARET  &kp AMPS   &kp STAR   &kp QMARK  &kp BSLH
                &kp LPAR   &kp RPAR   &kp LBKT   &kp RBKT   &kp EQUAL     &kp LBRC   &kp RBRC   &kp PIPE   &kp DQT    &kp SQT
                &kp MINUS  &kp UNDER  &kp GRAVE  &kp TILDE  &kp PLUS      &kp COLON  &kp SEMI   &kp LT     &kp GT     &trans
                                      &trans     &trans     &trans        &trans     &trans     &trans
            >;
        };

        adjust_layer {
            // Hold Sym (left inner) + Nav (right inner). Radios, output, and the F-row.
            // -----------------------------------------------------------------------------------------
            // |A1  |A2  |A3  |A4  |A5  |     |A6 |A7 |A8 |A9 |A0 |
            // |BT0 |BT1 |BT2 |BT3 |BT4 |     |F1 |F2 |F3 |F4 |F5 |
            // |CLR |USB |BLE |RST |BOOT|     |F6 |F7 |F8 |F9 |F10|
            //             |    |    |    |     |   |A- |A= |
            display-name = "Adj";
            bindings = <
                &kp RA(N1)    &kp RA(N2)    &kp RA(N3)    &kp RA(N4)   &kp RA(N5)     &kp RA(N6) &kp RA(N7)     &kp RA(N8)     &kp RA(N9) &kp RA(N0)
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4   &kp F1     &kp F2         &kp F3         &kp F4     &kp F5
                &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &sys_reset   &bootloader    &kp F6     &kp F7         &kp F8         &kp F9     &kp F10
                                            &trans        &trans       &trans         &trans     &kp RA(MINUS)  &kp RA(EQUAL)
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
