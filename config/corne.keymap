#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L0 0   // base
#define L1 1   // symbols
#define L2 2   // numbers / media
#define L3 3   // mouse (NAV P)
#define L4 4   // adjust (NAV /)
#define L5 5   // NAV

// Base 31/34 = L1/L2 (tap sticky, hold mo). 31+34 = base.
// L1 34: tap +, hold mo L2. L2 31: tap comma, hold mo L1.
// NAV = L1+L2, or hold /. P = mouse. / = L4.

// Unused.
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

// Inert unless CONFIG_ZMK_POINTING=y.
&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        // Unused.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // tap sl, hold mo. hold-preferred.
        slm: sticky_layer_momentary {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_MOMENTARY";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&sl>;
        };

        // Unused.
        slt: sticky_layer_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_TOGGLE";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&tog>, <&sl>;
        };

        // Unused.
        stp: step_or_stack {
            compatible = "zmk,behavior-hold-tap";
            label = "STEP_OR_STACK";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&to>;
        };

        // &td <hold> <tap>. quick-tap 200.
        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // tap ', hold ;. idle 100ms.
        qt: quote_semi {
            compatible = "zmk,behavior-hold-tap";
            label = "QUOTE_SEMI";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // tap /, hold NAV. &ns 0 FSLH (dummy param).
        ns: nav_slash {
            compatible = "zmk,behavior-hold-tap";
            label = "NAV_SLASH";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&nav_hold>, <&kp>;
        };

        // tap key, hold mo. hold-preferred.
        lk: layer_key {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_KEY";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // prefix+[
        tmux_scroll: tmux_scroll {
            compatible = "zmk,behavior-macro";
            label = "TMUX_SCROLL";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(SPACE) &kp LBKT>;
        };

        // prefix+z
        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            label = "TMUX_ZOOM";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(SPACE) &kp Z>;
        };

        // prefix+c
        tmux_new: tmux_new {
            compatible = "zmk,behavior-macro";
            label = "TMUX_NEW";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(SPACE) &kp C>;
        };

        // C-X
        cut: cut {
            compatible = "zmk,behavior-macro";
            label = "CUT";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(X)>;
        };

        // C-C
        copy: copy {
            compatible = "zmk,behavior-macro";
            label = "COPY";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(C)>;
        };

        // C-V
        paste: paste {
            compatible = "zmk,behavior-macro";
            label = "PASTE";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(V)>;
        };

        // Hold L1+L2 (feeds the NAV conditional). Dummy param for &ns.
        nav_hold: nav_hold {
            compatible = "zmk,behavior-macro-one-param";
            label = "NAV_HOLD";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo L1 &mo L2>
                , <&macro_pause_for_release>
                , <&macro_release &mo L1 &mo L2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J+K Esc. idle 100ms.
        combo_esc {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };

        // L+' Enter.
        combo_ret {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp RET>;
        };

        // Q+W Tab.
        combo_tab {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
        };

        // K+L colon. right hand, next to Esc and Enter.
        combo_col {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp COLON>;
        };

        // D+F copy. left home row. idle 100ms.
        combo_copy {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <12 13>;
            bindings = <&copy>;
        };

        // C+V paste. left hand. idle 100ms.
        combo_paste {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <22 23>;
            bindings = <&paste>;
        };

        // Both layer thumbs -> base. L1-L4.
        combo_to_base {
            timeout-ms = <50>;
            key-positions = <31 34>;
            layers = <L1 L2 L3 L4>;
            bindings = <&to L0>;
        };
    };

    // L1+L2 -> NAV. Do not &mo L5.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav {
            if-layers = <L1 L2>;
            then-layer = <L5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            // x/y = tap/hold. s = sticky.
            // Esc J+K, Enter L+', Tab Q+W, colon K+L, copy D+F, paste C+V.
            // |  Q  |  W  |  E  |  R/$ |  T  |     |  Y  |  U  |  I  | O/0 |  P  |
            // |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  | '/; |
            // |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  | ,/_ | ./! | /NAV|
            //             |sCTL | L1  |sSFT |     | SPC | L2  |BSPC |
            display-name = "L0";
            bindings = <
                &kp Q      &kp W      &kp E       &td DLLR R   &kp T        &kp Y      &kp U       &kp I       &td N0 O     &kp P
                &kp A      &kp S      &kp D       &kp F        &kp G        &kp H      &kp J       &kp K       &kp L        &qt SEMI SQT
                &kp Z      &kp X      &kp C       &kp V        &kp B        &kp N      &kp M       &td UNDER COMMA  &td EXCL DOT  &ns 0 FSLH
                                      &sk LCTRL   &slm L1 L1  &sk LSHIFT    &kp SPACE  &slm L2 L2  &kp BSPC
            >;
        };

        layer_1 {
            // |ESC| @ | # | % | $ |     | & | * | { | } | -  |
            // |TAB| < | > | ? | | |     | = | ( | ) | : | ;  |
            // | - | ! | ` | / | ~ |     | " | ^ | [ | ] | \ |
            //             | -  | L0 | -  |     | SPC | + |sALT|   + hold = mo L2
            display-name = "L1";
            bindings = <
                &kp ESC  &kp AT     &kp HASH   &kp PRCNT  &kp DLLR        &kp AMPS   &kp STAR  &kp LBRC   &kp RBRC   &kp MINUS
                &kp TAB     &kp LT    &kp GT     &kp QMARK  &kp PIPE      &kp EQUAL  &kp LPAR   &kp RPAR   &kp COLON   &kp SEMI
                &kp MINUS  &kp EXCL   &kp GRAVE  &kp FSLH   &kp TILDE     &kp DQT    &kp CARET  &kp LBKT   &kp RBKT    &kp BSLH
                                      &trans     &to L0     &trans        &kp SPACE  &lk L2 PLUS  &sk RALT
            >;
        };

        layer_2 {
            // | 1  | 2  | 3  | 4  | 5  |     | 6 | 7 | 8 | 9 | 0 |
            // |TAB |VOL-|VOL+|BRI-|BRI+|     | = | - | + | _ |RET|
            // |PSCR|CUT |COPY|PSTE|MUTE|     | / | * | ( | ) | . |
            //             |sCTL| ,  |GUI |     | SPC | L0 |sALT|   , hold = mo L1
            display-name = "L2";
            bindings = <
                &kp N1     &kp N2        &kp N3        &kp N4        &kp N5        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &kp TAB    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP  &kp EQUAL  &kp MINUS  &kp PLUS   &kp UNDER  &kp RET
                &kp PSCRN  &cut          &copy         &paste        &kp C_MUTE    &kp FSLH   &kp STAR   &kp LPAR   &kp RPAR   &kp DOT
                                         &sk LCTRL     &lk L1 COMMA  &kp LGUI      &kp SPACE  &to L0     &sk RALT
            >;
        };

        layer_3 {
            // Toggle from NAV P. BACK/FWD = A-Left/Right. TABS = C-S-A.
            // |ESC |SCR<|MV^ |SCR>|C-T |     |BACK|C-S-TAB|C-TAB|FWD |BSPC|
            // |TAB |MV< |MVv |MV> |DEL |     | <- |   v   |  ^  | -> |RET |
            // |    |RCLK|SCR^|SCRv|C-W |     |HOME| PGDN  |PGUP |END |TABS|
            //             | -  | -  |LCLK|     | -  | -  | -  |
            display-name = "MOUSE";
            bindings = <
                &kp ESC  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &kp LC(T)  &kp LA(LEFT)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LA(RIGHT)  &kp BSPC
                &kp TAB  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp DEL    &kp LEFT      &kp DOWN         &kp UP       &kp RIGHT      &kp RET
                &trans   &mkp RCLK       &msc SCRL_UP    &msc SCRL_DOWN   &kp LC(W)  &kp HOME      &kp PG_DN        &kp PG_UP    &kp END        &kp LC(LS(A))
                                         &trans          &trans          &mkp LCLK   &trans        &trans           &trans
            >;
        };

        layer_4 {
            // NAV / only. trans falls through.
            // |TAB |    |    |    |BT4 |     |F1 |F2 |F3 |F4 |BSPC|
            // |ESC |BT0 |BT1 |BT2 |BT3 |     |F5 |F6 |F7 |F8 |RET |
            // |CLR |USB |BLE |RST |BOOT|     |F9 |F10|F11|F12|    |
            //             | -  | L0 | -  |     | SPC | L0 |sALT|
            display-name = "L4";
            bindings = <
                &kp ESC       &trans        &trans        &trans        &bt BT_SEL 4  &kp F1     &kp F2         &kp F3         &kp F4     &kp BSPC
                &kp TAB       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F5     &kp F6         &kp F7         &kp F8     &kp RET
                &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &sys_reset    &bootloader   &kp F9     &kp F10        &kp F11        &kp F12    &trans
                                            &trans        &to L0        &trans        &kp SPACE  &to L0         &sk RALT
            >;
        };

        layer_5 {
            // L1+L2 or hold /. ASDF arrows, HJKL tmux panes, P mouse, / L4.
            // |A-1 |A-2 |A-3 |A-4 |A-5 |     |A-6 |A-7 |A-8 |A-9 |MOUSE|
            // | <- |  v |  ^ | -> |    |     |pane←|pane↓|pane↑|pane→|    |
            // |sGUI|sALT|sSFT|sCTL|    |     |    |SCRL|    |    | L4 |
            //             |ZOOM| NEW | -  |     |TAB>|TAB<| -  |
            display-name = "NAV";
            bindings = <
                &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &tog L3
                &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &kp LA(LS(H)) &kp LA(LS(J)) &kp LA(LS(K)) &kp LA(LS(L)) &trans
                &sk LGUI    &sk LALT    &sk LSHIFT  &sk LCTRL  &trans      &trans      &tmux_scroll &trans      &trans      &to L4
                                        &tmux_zoom  &tmux_new   &trans      &kp LC(TAB)  &kp LC(LS(TAB)) &trans
            >;
        };

        layer_6 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
