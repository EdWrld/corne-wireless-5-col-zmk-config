#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L0 0   // base
#define L1 1   // symbols
#define L2 2   // numbers / nav
#define L3 3   // adjust
#define L4 4   // mouse

// Thumb positions 31 (left) and 34 (right) drive every layer change.
//   base    31 = &slt L1, 34 = &slt L2   tap = sticky one key, hold 250ms = lock on
//   L1-L4   31 = step out, 34 = step in, 31+34 = back to base
//
//     L0 --34--> L1 --34--> L2 --34--> L3 --34--> L4 --34--> L0
//        <--31--    <--31--    <--31--    <--31--
//
// Tab and Esc are at positions 0 and 10 on every non-base layer.

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

// Inert unless CONFIG_ZMK_POINTING=y.
&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        // Unused. Kept so a home-row mod can be re-added in one word.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // tap = &sl (layer drops after the next keycode), hold 250ms = &tog (locks on).
        slt: sticky_layer_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_TOGGLE";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&tog>, <&sl>;
        };

        // &td <hold> <tap>, 150ms.
        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    // tmux prefix is C-Space; these fire prefix-then-key. All three are
    // currently unreferenced by any layer.
    macros {
        tmux_below: tmux_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp DQT>;
        };

        tmux_right: tmux_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp PRCNT>;
        };

        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(SPACE)>, <&kp Z>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J+K -> Esc, base only.
        combo_esc {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <16 17>;
            layers = <L0>;
            bindings = <&kp ESC>;
        };

        // Both layer thumbs -> base. Off L0, so the base thumbs are unaffected.
        combo_to_base {
            timeout-ms = <50>;
            key-positions = <31 34>;
            layers = <L1 L2 L3 L4>;
            bindings = <&to L0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            // x/y = tap x, hold y.  s = sticky.
            // No Delete anywhere in the keymap.
            // |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  | O/- |  P  |
            // |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  | ,/_ | ./! |  /  |
            //             |sCTL | L1  |sSFT |     | SPC | L2  | TAB |
            display-name = "L0";
            bindings = <
                &kp Q      &kp W      &kp E       &kp R        &kp T        &kp Y      &kp U       &kp I       &td MINUS O  &kp P
                &kp A      &kp S      &kp D       &kp F        &kp G        &kp H      &kp J       &kp K       &kp L      &kp SEMI
                &kp Z      &kp X      &kp C       &kp V        &kp B        &kp N      &kp M       &td UNDER COMMA  &td EXCL DOT  &kp FSLH
                                      &sk LCTRL   &slt L1 L1  &sk LSHIFT    &kp SPACE  &slt L2 L2  &kp TAB
            >;
        };

        layer_1 {
            // Every symbol is direct; no Shift needed. All four brackets sit on one
            // row. Blank cell is &trans -> base C.
            // |TAB| @ | # | $ | % |     | ~ | ^ | * | & |BSPC|
            // |ESC| ' | ` | | | \ |     | = | ( | ) | ! |RET |
            // | - | " |   | + | _ |     | [ | { | } | ] | / |
            //             | -  | L0 | -  |     |sALT| L2 | -  |
            display-name = "L1";
            bindings = <
                &kp TAB    &kp AT     &kp HASH   &kp DLLR   &kp PRCNT     &kp TILDE  &kp CARET  &kp STAR   &kp AMPS   &kp BSPC
                &kp ESC    &kp SQT    &kp GRAVE  &kp PIPE   &kp BSLH      &kp EQUAL  &kp LPAR   &kp RPAR   &kp EXCL   &kp RET
                &kp MINUS  &kp DQT    &trans     &kp PLUS   &kp UNDER     &kp LBKT   &kp LBRC   &kp RBRC   &kp RBKT   &kp FSLH
                                      &trans     &to L0     &trans        &sk RALT   &to L2     &trans
            >;
        };

        layer_2 {
            // Right hand: numpad. Left hand: clipboard, media, math operators.
            // CUT/COPY/PSTE sit in the same columns as base X C V.
            // |TAB |CUT |COPY|PSTE| -  |     | _ | 7 | 8 | 9 |BSPC|
            // |ESC |PSCR|VOL-|VOL+| +  |     | = | 4 | 5 | 6 |RET |
            // |    | *  |BRI-|BRI+|MUTE|     | 0 | 1 | 2 | 3 | .  |
            //             |sCTL| L1 |GUI |     |sALT| L3 | -  |
            display-name = "L2";
            bindings = <
                &kp TAB    &kp K_CUT  &kp K_COPY    &kp K_PASTE   &kp MINUS     &kp UNDER  &kp N7     &kp N8     &kp N9     &kp BSPC
                &kp ESC    &kp PSCRN  &kp C_VOL_DN  &kp C_VOL_UP  &kp PLUS      &kp EQUAL  &kp N4     &kp N5     &kp N6     &kp RET
                &trans     &kp STAR   &kp C_BRI_DN  &kp C_BRI_UP  &kp C_MUTE    &kp N0     &kp N1     &kp N2     &kp N3     &kp DOT
                                      &sk LCTRL     &to L1        &kp LGUI      &sk RALT   &to L3     &trans
            >;
        };

        layer_3 {
            // A<n> = RALT+<n>.
            // |TAB |A1  |A2  |A3  |A4  |     |F1 |F2 |F3 |F4 |BSPC|
            // |ESC |BT0 |BT1 |BT2 |BT3 |     |F5 |F6 |F7 |F8 |RET |
            // |CLR |USB |BLE |RST |BOOT|     |F9 |F10|F11|F12|A5  |
            //             |A-  | L2 |BT4 |     |sALT| L4 |A= |
            display-name = "L3";
            bindings = <
                &kp TAB       &kp RA(N1)    &kp RA(N2)    &kp RA(N3)    &kp RA(N4)    &kp F1     &kp F2         &kp F3         &kp F4     &kp BSPC
                &kp ESC       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F5     &kp F6         &kp F7         &kp F8     &kp RET
                &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &sys_reset    &bootloader   &kp F9     &kp F10        &kp F11        &kp F12    &kp RA(N5)
                                            &kp RA(MINUS) &to L2        &bt BT_SEL 4  &sk RALT   &to L4         &kp RA(EQUAL)
            >;
        };

        layer_4 {
            // |TAB |SCR<|MV^ |SCR>| -  |     | - | -  | -  | -  |BSPC|
            // |ESC |MV< |MVv |MV> | -  |     | - |LCLK|MCLK|RCLK|RET |
            // | -  |SCRv|SCR^| -  | -  |     | - | -  | -  | -  | -  |
            //             | L0 | L3 | -  |     | - | L0 | -  |
            display-name = "L4";
            bindings = <
                &kp TAB &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans     &trans  &trans     &trans     &trans     &kp BSPC
                &kp ESC &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans     &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp RET
                &trans  &msc SCRL_DOWN  &msc SCRL_UP    &trans           &trans     &trans  &trans     &trans     &trans     &trans
                                        &to L0          &to L3           &trans     &trans  &to L0     &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };
    };
};
