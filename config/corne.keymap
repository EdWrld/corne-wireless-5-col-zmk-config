#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L0 0   // base
#define L1 1   // symbols
#define L2 2   // numbers / media
#define L3 3   // pointer / browser
#define L4 4   // adjust
#define L5 5   // windows (spur)

// Thumb positions 31 (left) and 34 (right) drive every layer change.
//   base    31 = &slm L1   tap = sticky one key, hold = momentary while held
//           34 = &slm L2   tap = sticky one key, hold = momentary while held
//           31+34 = NAV, live while both are held — not on the ring
//   L1-L4   31 = step out, 34 = step in, 31+34 = back to base
//
//     L0 --34--> L1 --34--> L2 --34--> L3 ..hold 34..> L4
//        <--31--    <--31--    <--31--
//     L0 <── 31+34 hold ──> L5 (NAV)
//
// L4 is the exception: hold, never tap, so the radios and bootloader cannot be
// reached by tapping the step-in thumb one time too many.
//
// Tab and Esc are at positions 0 and 10 on L1–L4. NAV’s top row is Alt+1–9.

// Unused by any layer; kept for a future mod-tap.
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

// Inert unless CONFIG_ZMK_POINTING=y.
&mmv {
    time-to-max-speed-ms = <680>;
    acceleration-exponent = <2>;
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        // Unused. Kept so a home-row mod can be re-added in one word.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // tap = &sl (layer drops after the next keycode), hold = &mo (live while held).
        // hold-preferred so the layer is live the instant another key goes down -
        // no 250 ms dead spot before the first symbol. Safe here because both
        // branches emit the same character; only the exit differs.
        slm: sticky_layer_momentary {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_MOMENTARY";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&sl>;
        };

        // tap = &sl (layer drops after the next keycode), hold 250ms = &tog (locks on).
        // Unused: L2 moved to &slm to match L1. Kept for a one-word revert.
        slt: sticky_layer_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_LAYER_TOGGLE";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&tog>, <&sl>;
        };

        // &td <hold> <tap>, 200ms.
        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // prefix (Ctrl+Space) then [ — tmux copy/scroll mode. wait/tap 40 ms
        // so the host sees two distinct reports, not a mashed chord.
        tmux_scroll: tmux_scroll {
            compatible = "zmk,behavior-macro";
            label = "TMUX_SCROLL";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(SPACE) &kp LBKT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Positions 16+17 (J+K on base) -> Esc, every layer.
        combo_esc {
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            key-positions = <16 17>;
            bindings = <&kp ESC>;
        };

        // Positions 18+19 (L+' on base) -> Enter, every layer. No
        // require-prior-idle here: it needs to fire immediately after a
        // letter, which is the :w<CR> rhythm.
        combo_ret {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp RET>;
        };

        // Both layer thumbs -> base. Off L0, so the base thumbs are unaffected.
        combo_to_base {
            timeout-ms = <50>;
            key-positions = <31 34>;
            layers = <L1 L2 L3 L4>;
            bindings = <&to L0>;
        };

        // Both layer thumbs from base -> NAV. slow-release keeps the layer
        // up until both thumbs come up, so one lifting early does not dump
        // you mid-hop. Not listed on combo_to_base: releasing the hold is
        // the exit, and the same keys must not fire &to L0 while NAV is on.
        combo_nav {
            timeout-ms = <50>;
            slow-release;
            key-positions = <31 34>;
            layers = <L0>;
            bindings = <&mo L5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            // x/y = tap x, hold y.  s = sticky.
            // Delete and Tab are not on base; Tab is at position 0 on every other
            // layer. Esc is the J+K combo, Enter is L+; — both on every layer.
            // |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  | O/- |  P  |
            // |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  | '/; |
            // |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  | ,/_ | ./! |  /  |
            //             |sCTL | L1  |sSFT |     | SPC | L2  |BSPC |   L1 and L2: tap = one key,
            //                                                            hold = momentary while held
            display-name = "L0";
            bindings = <
                &kp Q      &kp W      &kp E       &kp R        &kp T        &kp Y      &kp U       &kp I       &td MINUS O  &kp P
                &kp A      &kp S      &kp D       &kp F        &kp G        &kp H      &kp J       &kp K       &kp L        &kp SQT
                &kp Z      &kp X      &kp C       &kp V        &kp B        &kp N      &kp M       &td UNDER COMMA  &td EXCL DOT  &kp FSLH
                                      &sk LCTRL   &slm L1 L1  &sk LSHIFT    &kp SPACE  &slm L2 L2  &kp BSPC
            >;
        };

        layer_1 {
            // Every symbol is direct; no Shift needed.
            // ~ and + are not bound: they are Shift + the ` and = on this layer.
            // All three bracket pairs share two columns - openers on the index,
            // closers on the middle - so only the row changes between them.
            // |TAB| @ | # | % | $ |     | 0 | { | } | & |BSPC|
            // |ESC| " | * | ? | | |     | = | ( | ) | ; |RET |
            // | - | ! | ` | / | _ |     | < | [ | ] | > | \ |
            //             | -  | L0 | -  |     | SPC | L2 |sALT|
            display-name = "L1";
            bindings = <
                &kp ESC  &kp AT     &kp HASH   &kp PRCNT  &kp DLLR        &kp AMPS   &kp N0   &kp LBRC   &kp RBRC   &kp BSPC
                &kp TAB     &kp DQT   &kp STAR   &kp QMARK  &kp PIPE      &kp EQUAL  &kp LPAR   &kp RPAR   &kp COLON   &kp SEMI
                &kp MINUS  &kp EXCL   &kp GRAVE  &kp FSLH   &kp UNDER     &kp LT     &kp LBKT   &kp RBKT   &kp GT     &kp BSLH
                                      &trans     &to L0     &trans        &kp SPACE  &to L2     &sk RALT
            >;
        };

        layer_2 {
            // Top row is the number row, 1-0 straight across both hands.
            // Right hand below it is the math block, left hand is media plus
            // clipboard, with CUT/COPY/PSTE in the same columns as base X C V.
            // No Esc or Enter key here - both are combos on every layer:
            // 16+17 -> Esc, 18+19 -> Enter.
            // | 1  | 2  | 3  | 4  | 5  |     | 6 | 7 | 8 | 9 | 0 |
            // |TAB |VOL-|VOL+|BRI-|BRI+|     | = | - | + | _ |RET|
            // |PSCR|CUT |COPY|PSTE|MUTE|     | / | * | ( | ) | . |
            //             |sCTL| L1 |GUI |     | SPC | L3 |sALT|
            display-name = "L2";
            bindings = <
                &kp N1     &kp N2        &kp N3        &kp N4        &kp N5        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &kp TAB    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP  &kp EQUAL  &kp MINUS  &kp PLUS   &kp UNDER  &kp RET
                &kp PSCRN  &kp K_CUT     &kp K_COPY    &kp K_PASTE   &kp C_MUTE    &kp FSLH   &kp STAR   &kp LPAR   &kp RPAR   &kp DOT
                                         &sk LCTRL     &to L1        &kp LGUI      &kp SPACE  &to L3     &sk RALT
            >;
        };

        layer_3 {
            // Left hand drives the pointer, right hand is arrows + browser control.
            // BACK/FWD  = Alt+Left / Alt+Right, sitting right above the <- and -> arrows
            // C-S-TAB / C-TAB = previous / next tab      TABS = Ctrl+Shift+A, Chrome tab search
            // C-T / C-W = new tab / close tab, same column: top opens, bottom closes.
            // |TAB |SCR<|MV^ |SCR>|C-T |     |BACK|C-S-TAB|C-TAB|FWD |BSPC|
            // |ESC |MV< |MVv |MV> |DEL |     | <- |   v   |  ^  | -> |RET |
            // |    |RCLK|SCR^|SCRv|C-W |     |HOME| PGDN  |PGUP |END |TABS|
            //             | L0 | L2 |LCLK|     | SPC | L4 |sALT|   L4 is HOLD only, not a tap
            display-name = "L3";
            bindings = <
                &kp ESC &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &kp LC(T)  &kp LA(LEFT)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LA(RIGHT)  &kp BSPC
                &kp TAB  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp DEL    &kp LEFT      &kp DOWN         &kp UP       &kp RIGHT      &kp RET
                &trans   &mkp RCLK       &msc SCRL_UP    &msc SCRL_DOWN   &kp LC(W)  &kp HOME      &kp PG_DN        &kp PG_UP    &kp END        &kp LC(LS(A))
                                         &to L0          &to L2           &mkp LCLK  &kp SPACE  &mo L4           &sk RALT
            >;
        };

        layer_4 {
            // Reached only by HOLDING position 34 on L3 - a tap does nothing. That
            // keeps sys_reset, bootloader and the radios off the tap-to-step-in ring,
            // so walking the thumb can never land you here.
            // Blank cells fall through to base.
            // |TAB |    |    |    |BT4 |     |F1 |F2 |F3 |F4 |BSPC|
            // |ESC |BT0 |BT1 |BT2 |BT3 |     |F5 |F6 |F7 |F8 |RET |
            // |CLR |USB |BLE |RST |BOOT|     |F9 |F10|F11|F12|    |
            //             | -  | L3 | -  |     | SPC | L0 |sALT|
            display-name = "L4";
            bindings = <
                &kp ESC       &trans        &trans        &trans        &bt BT_SEL 4  &kp F1     &kp F2         &kp F3         &kp F4     &kp BSPC
                &kp TAB       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F5     &kp F6         &kp F7         &kp F8     &kp RET
                &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &sys_reset    &bootloader   &kp F9     &kp F10        &kp F11        &kp F12    &trans
                                            &trans        &to L3        &trans        &kp SPACE  &to L0         &sk RALT
            >;
        };

        layer_5 {
            // Spur off base: both layer thumbs, live while held.
            // Top row: Alt+1–9 window hops.
            // Left home ASDF: tmux panes (Alt+Shift+H/J/K/L = left / down / up / right).
            // Right home HJKL: arrows, same vim order, same cluster as L3.
            // M is the same finger as [ on L1: prefix+[ enters copy/scroll.
            // |A-1 |A-2 |A-3 |A-4 |A-5 |     |A-6 |A-7 |A-8 |A-9 |    |
            // |A-S-H|A-S-J|A-S-K|A-S-L|    |     | <- |  v |  ^ | -> |    |
            // |    |    |    |    |    |     |    |SCRL|    |    |    |
            //             | -  | -  | -  |     | -  | -  | -  |
            display-name = "NAV";
            bindings = <
                &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &trans
                &kp LA(LS(H)) &kp LA(LS(J)) &kp LA(LS(K)) &kp LA(LS(L)) &trans      &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &trans
                &trans      &trans      &trans      &trans      &trans      &trans      &tmux_scroll &trans      &trans      &trans
                                        &trans      &trans      &trans      &trans      &trans      &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };
    };
};
